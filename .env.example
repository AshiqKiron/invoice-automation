# ============================================
# Invoice Automation - Environment Variables
# ============================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit your .env file to git!
# ============================================

# [REQUIRED] Groq API Key
# Get a free key at: https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# [OPTIONAL] Groq model ID (check available models via API)
GROQ_MODEL=qwen/qwen3.6-27b

# [OPTIONAL] LLM Provider: "groq" or "ollama"
LLM_PROVIDER=groq

# [OPTIONAL] Ollama settings (only used when LLM_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434/api/generate
OLLAMA_MODEL=llama3.2

# [OPTIONAL] Accounting API settings
API_BASE_URL=http://localhost:8080
API_KEY=demo-key-1234
